# Development environment overrides.
# Copy to `.env` and adjust as needed; `scripts/dev-setup.sh` creates `.env`
# from this file automatically and the build/test scripts source it if present.

# Severity used by `dotnet format analyzers` when verifying formatting (warn | error).
FORMAT_ANALYZER_SEVERITY=warn

# Set to 1 to make scripts/dotnet-format.sh auto-apply formatting instead of verifying.
# FORMAT_APPLY=1

# Minimum branch coverage percentage required by scripts/test-coverage.sh.
BRANCH_COVERAGE_THRESHOLD=100
